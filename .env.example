# ─────────────────────────────────────────────────────────────────────────────
# Segment-Based Train Seat Booking System — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
ENVIRONMENT=development     # development | production

# ── PostgreSQL Database ───────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=trainbooking
DB_PASSWORD=trainbooking_secret
DB_NAME=trainbooking_db
DB_SSLMODE=disable
DATABASE_URL=postgres://trainbooking:trainbooking_secret@postgres:5432/trainbooking_db?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Seat Hold Configuration ───────────────────────────────────────────────────
SEAT_HOLD_DURATION_MINUTES=5

# ── Fare Configuration (configurable — no hardcoding in business logic) ───────
BASE_RATE_PER_STATION_LKR=45.00   # LKR per station unit traversed
RESERVED_COACH_MULTIPLIER=1.8     # Reserved seat surcharge multiplier
UNRESERVED_COACH_MULTIPLIER=1.0   # Unreserved base multiplier

# ── Train Configuration ───────────────────────────────────────────────────────
TOTAL_COACHES=8
RESERVED_COACH_COUNT=3            # Coaches 1-3 are reserved
UNRESERVED_COACH_COUNT=5          # Coaches 4-8 are unreserved
SEATS_PER_RESERVED_COACH=48
SEATS_PER_UNRESERVED_COACH=72

# ── JWT Auth (Admin Panel) ────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_in_production
JWT_EXPIRY_HOURS=24

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
